// File name: projects/1/Xor.hdl
/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    // Not(b) and a
    Not(in=b, out=p1);
    And(a=a, b=p1, out=p2);
    // Not(a) and b
    Not(in=a, out=p3);
    And(a=b, b=p3, out=p4);
    // Or
    Or(a=p2, b=p4, out=out);
}
