// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];

    PARTS:
    // Increment outreg
    Inc16(in=outreg, out=outinc);
    // Select between outreg and inc
    Mux16(a=outreg, b=outinc, sel=inc, out=outregoutinc);
    // Select between outregoutinc and load
    Mux16(a=outregoutinc, b=in, sel=load, out=outregoutincin);
    // Select between outregoutincin and reset
    Mux16(a=outregoutincin, b=false, sel=reset, out=outregoutincinreset);
    // Set register
    Register(in=outregoutincinreset, load=true, out=out, out=outreg);
}
